POSTGRES_DB="workflowpro"
POSTGRES_USER="workflowpro"
POSTGRES_PASSWORD="replace-with-a-random-hex-secret"
DATABASE_URL="postgresql://workflowpro:replace-with-a-random-hex-secret@database:5432/workflowpro"

# NextAuth.js Configuration
NEXTAUTH_URL="https://worksmart.turlacu.ro"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-48"

# Set these for the first deployment, then remove them after the administrator is created.
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-random-one-time-password"

# MinIO Configuration (S3-compatible storage)
MINIO_ENDPOINT="minio:9000"
MINIO_USE_SSL="false"
MINIO_ROOT_USER="replace-with-random-access-key"
MINIO_ROOT_PASSWORD="replace-with-random-secret-key"
MINIO_BUCKET_NAME="workflowpro-storage"

# Token for the remotely managed Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN="replace-with-cloudflare-tunnel-token"

# Application Environment
NODE_ENV="production"
